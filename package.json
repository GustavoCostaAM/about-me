{
  "name": "about-me",
  "version": "1.0.0",
  "private": true,
  "description": "Validação e publicação do site estático apresentacaoPessoal",
  "type": "module",
  "engines": { "node": ">=22.18.0 <23" },
  "scripts": {
    "build": "python tools/site.py build",
    "check:links": "python tools/site.py check",
    "check:external": "python tools/site.py external",
    "update:sri": "python tools/site.py sri",
    "lint:html": "node node_modules/html-validate/bin/html-validate.mjs \"**/*.html\"",
    "lint:css": "node node_modules/stylelint/bin/stylelint.mjs \"**/*.css\" --ignore-pattern node_modules/** --ignore-pattern dist/**",
    "lint": "npm run lint:html && npm run lint:css",
    "test:a11y": "node tools/accessibility.mjs",
    "test": "npm run build && npm run lint && npm run check:links && npm run check:external && npm run test:a11y",
    "test:integrity": "python -m unittest discover -s tools/tests -v"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "html-validate": "10.0.0",
    "playwright": "1.55.1",
    "stylelint": "16.23.1",
    "stylelint-config-standard": "39.0.0"
  }
}
